{
  "name": "06 - Friday Bridge (True Press -> Friday alerts)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 15 }] }
      },
      "id": "schedule",
      "name": "Every 15 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/processed_news?select=id,title,summary,impact_rodrigo,level_1_domain,score_brasil,borin_index_tags,processed_at&score_brasil=gte.80&processed_at=gte.{{ $now.minus({minutes:15}).toISO() }}&order=score_brasil.desc&limit=20",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_ANON_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_ANON_KEY }}" }
          ]
        }
      },
      "id": "fetch-high-impact",
      "name": "Fetch High-Impact News",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "conditions": [
            {
              "leftValue": "={{ $json.length }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "has-news",
      "name": "Has News?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FRIDAY_WEBHOOK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "x-truepress-key", "value": "={{ $env.FRIDAY_SHARED_KEY }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"source\": \"true-press\",\n  \"type\": \"high_impact_alert\",\n  \"generated_at\": \"{{ $now.toISO() }}\",\n  \"articles\": {{ JSON.stringify($json) }}\n}"
      },
      "id": "push-friday",
      "name": "Push to Friday Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 240]
    }
  ],
  "connections": {
    "Every 15 min": { "main": [[{ "node": "Fetch High-Impact News", "type": "main", "index": 0 }]] },
    "Fetch High-Impact News": { "main": [[{ "node": "Has News?", "type": "main", "index": 0 }]] },
    "Has News?": { "main": [[{ "node": "Push to Friday Webhook", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "truepress" }, { "name": "friday" }]
}
